# Required for LLM analysis, embeddings, and LangSmith tracing
OPENAI_API_KEY=
# Required PostgreSQL connection string (Neon, Supabase, Vercel Postgres, etc.)
DATABASE_URL=
# Middle East job sources. Set any combination; with none, the UI shows clearly labelled demo listings.
# Careerjet partner key: UAE, Saudi Arabia, Qatar, Kuwait, Oman
CAREERJET_API_KEY=
# Jooble API key (free, from jooble.org/api/about): all 8 supported countries
JOOBLE_API_KEY=
# JSearch key from RapidAPI (Google for Jobs aggregate): all 8 supported countries
JSEARCH_API_KEY=
# LangSmith tracing is optional
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=job-scout-multi-agent
# Optional model overrides
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
